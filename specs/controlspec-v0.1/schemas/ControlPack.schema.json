{
  "$defs": {
    "ActorType": {
      "enum": [
        "agent",
        "human",
        "service",
        "workflow",
        "application",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ApprovalRequirement": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/$defs/FailureEffect"
        },
        "minimum_count": {
          "exclusiveMinimum": 0,
          "title": "Minimum Count",
          "type": "integer"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement_type": {
          "const": "approval",
          "default": "approval",
          "title": "Requirement Type",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Scope",
          "type": "object"
        },
        "separate_from_actor": {
          "title": "Separate From Actor",
          "type": "boolean"
        },
        "separate_from_roles": {
          "$ref": "#/$defs/CanonicalSet_Annotated_str__StringConstraints__"
        },
        "validity_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Validity Seconds"
        }
      },
      "required": [
        "requirement_id",
        "failure",
        "role",
        "scope",
        "minimum_count",
        "validity_seconds",
        "separate_from_actor",
        "separate_from_roles"
      ],
      "title": "ApprovalRequirement",
      "type": "object"
    },
    "CanonicalAction": {
      "enum": [
        "observe",
        "infer",
        "communicate",
        "modify",
        "commit",
        "transfer",
        "delegate"
      ],
      "title": "CanonicalAction",
      "type": "string"
    },
    "CanonicalSet_ActorType__MinLen_min_length_1_": {
      "items": {
        "$ref": "#/$defs/ActorType"
      },
      "type": "array"
    },
    "CanonicalSet_Annotated_str__StringConstraints__": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "CanonicalSet_Annotated_str__StringConstraints___MinLen_min_length_1_": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "CanonicalSet_CanonicalAction__MinLen_min_length_1_": {
      "items": {
        "$ref": "#/$defs/CanonicalAction"
      },
      "type": "array"
    },
    "CanonicalSet_Condition_": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "type": "array"
    },
    "CanonicalSet_ControlPackRef_": {
      "items": {
        "$ref": "#/$defs/ControlPackRef"
      },
      "type": "array"
    },
    "CanonicalSet_Control_": {
      "items": {
        "$ref": "#/$defs/Control"
      },
      "type": "array"
    },
    "CanonicalSet_ExtensionDeclaration_": {
      "items": {
        "$ref": "#/$defs/ExtensionDeclaration"
      },
      "type": "array"
    },
    "CanonicalSet_JsonValue_": {
      "items": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "array"
    },
    "CanonicalSet_Predicate_": {
      "items": {
        "$ref": "#/$defs/Predicate"
      },
      "type": "array"
    },
    "CanonicalSet_Requirement_": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "type": "array"
    },
    "CanonicalSet_RouteDeclaration_": {
      "items": {
        "$ref": "#/$defs/RouteDeclaration"
      },
      "type": "array"
    },
    "CanonicalSet_SourceReference_": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "type": "array"
    },
    "CanonicalSet_VerifierDeclaration_": {
      "items": {
        "$ref": "#/$defs/VerifierDeclaration"
      },
      "type": "array"
    },
    "CanonicalSet_dict_str__JsonValue__": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "type": "array"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/FailureEffect"
        },
        "parameters": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Parameters",
          "type": "object"
        },
        "verifier": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "verifier",
        "parameters",
        "failure"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Control": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Control Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/ControlEffect"
        },
        "effective_from": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective From"
        },
        "effective_until": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Until"
        },
        "extensions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "match": {
          "$ref": "#/$defs/ControlMatch"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "namespace": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "on_unknown": {
          "$ref": "#/$defs/FailureEffect"
        },
        "owner_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema": {
          "const": "controlspec/v0/control",
          "default": "controlspec/v0/control",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Digest"
        },
        "source_refs": {
          "$ref": "#/$defs/CanonicalSet_SourceReference_",
          "default": []
        },
        "status": {
          "$ref": "#/$defs/ControlStatus"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "control_id",
        "version",
        "status",
        "effective_from",
        "effective_until",
        "title",
        "description",
        "match",
        "on_unknown",
        "effect"
      ],
      "title": "Control",
      "type": "object"
    },
    "ControlEffect": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Code",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/CanonicalSet_Condition_"
        },
        "requirements": {
          "$ref": "#/$defs/CanonicalSet_Requirement_"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "verdict": {
          "enum": [
            "allow",
            "allow_with_conditions",
            "require_approval",
            "route",
            "block"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "route",
        "requirements",
        "conditions",
        "code"
      ],
      "title": "ControlEffect",
      "type": "object"
    },
    "ControlMatch": {
      "additionalProperties": false,
      "properties": {
        "action_types": {
          "$ref": "#/$defs/CanonicalSet_CanonicalAction__MinLen_min_length_1_",
          "minLength": 1
        },
        "actor_types": {
          "$ref": "#/$defs/CanonicalSet_ActorType__MinLen_min_length_1_",
          "minLength": 1
        },
        "domain_actions": {
          "$ref": "#/$defs/CanonicalSet_Annotated_str__StringConstraints___MinLen_min_length_1_",
          "minLength": 1
        },
        "predicates": {
          "$ref": "#/$defs/CanonicalSet_Predicate_"
        },
        "resource_types": {
          "$ref": "#/$defs/CanonicalSet_Annotated_str__StringConstraints___MinLen_min_length_1_",
          "minLength": 1
        }
      },
      "required": [
        "actor_types",
        "action_types",
        "domain_actions",
        "resource_types",
        "predicates"
      ],
      "title": "ControlMatch",
      "type": "object"
    },
    "ControlPackRef": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "pack_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pack Id",
          "type": "string"
        },
        "semantic_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Semantic Digest",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "pack_id",
        "version",
        "semantic_digest"
      ],
      "title": "ControlPackRef",
      "type": "object"
    },
    "ControlStatus": {
      "enum": [
        "draft",
        "published",
        "retired"
      ],
      "title": "ControlStatus",
      "type": "string"
    },
    "CoreRouteKind": {
      "enum": [
        "continue",
        "ask_user",
        "human_review",
        "specialist_agent",
        "different_model",
        "redact_then_continue",
        "narrow_action",
        "block",
        "record_only"
      ],
      "title": "CoreRouteKind",
      "type": "string"
    },
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/$defs/FailureEffect"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Kind",
          "type": "string"
        },
        "max_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Age Seconds"
        },
        "minimum_count": {
          "exclusiveMinimum": 0,
          "title": "Minimum Count",
          "type": "integer"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement_type": {
          "const": "evidence",
          "default": "evidence",
          "title": "Requirement Type",
          "type": "string"
        },
        "separation": {
          "$ref": "#/$defs/EvidenceSeparation"
        },
        "subject": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Subject",
          "type": "string"
        },
        "verifier": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "failure",
        "kind",
        "subject",
        "minimum_count",
        "max_age_seconds",
        "verifier",
        "separation"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "EvidenceSeparation": {
      "additionalProperties": false,
      "properties": {
        "certifier_not_actor": {
          "title": "Certifier Not Actor",
          "type": "boolean"
        },
        "producer_certifier_distinct": {
          "title": "Producer Certifier Distinct",
          "type": "boolean"
        },
        "producer_not_actor": {
          "title": "Producer Not Actor",
          "type": "boolean"
        }
      },
      "required": [
        "producer_not_actor",
        "certifier_not_actor",
        "producer_certifier_distinct"
      ],
      "title": "EvidenceSeparation",
      "type": "object"
    },
    "ExtensionDeclaration": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "authority",
            "evidence",
            "display"
          ],
          "title": "Classification",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Key",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version",
        "classification",
        "required"
      ],
      "title": "ExtensionDeclaration",
      "type": "object"
    },
    "FailureEffect": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Code",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Route"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "enum": [
            "require_approval",
            "route",
            "block"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "route",
        "code"
      ],
      "title": "FailureEffect",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Digest"
        },
        "namespace": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Object Type",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "namespace",
        "object_type",
        "object_id",
        "version",
        "digest"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "operator": {
          "enum": [
            "eq",
            "in",
            "lt",
            "lte",
            "gt",
            "gte",
            "exists"
          ],
          "title": "Operator",
          "type": "string"
        },
        "path": {
          "pattern": "^/(actor|action|resource|context)(/.*)?$",
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "$ref": "#/$defs/CanonicalSet_JsonValue_",
          "default": []
        }
      },
      "required": [
        "operator",
        "path"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "ProfileRequirement": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/$defs/FailureEffect"
        },
        "parameters": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Parameters",
          "type": "object"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement_type": {
          "const": "profile",
          "default": "profile",
          "title": "Requirement Type",
          "type": "string"
        },
        "verifier": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "failure",
        "verifier",
        "parameters"
      ],
      "title": "ProfileRequirement",
      "type": "object"
    },
    "Requirement": {
      "discriminator": {
        "mapping": {
          "approval": "#/$defs/ApprovalRequirement",
          "evidence": "#/$defs/EvidenceRequirement",
          "profile": "#/$defs/ProfileRequirement"
        },
        "propertyName": "requirement_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/EvidenceRequirement"
        },
        {
          "$ref": "#/$defs/ApprovalRequirement"
        },
        {
          "$ref": "#/$defs/ProfileRequirement"
        }
      ]
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoreRouteKind"
            },
            {
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
              "type": "string"
            }
          ],
          "title": "Kind"
        },
        "namespace": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "parameters": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Parameters",
          "type": "object"
        },
        "requires_recheck": {
          "title": "Requires Recheck",
          "type": "boolean"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Route Id",
          "type": "string"
        },
        "schema": {
          "const": "controlspec/v0/route",
          "default": "controlspec/v0/route",
          "title": "Schema",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
